# VoltSentry dashboard — local environment
#
# OpenChargeMap API key for the /globe page (global EV charging network view).
# Get a free key: https://openchargemap.org/site/profile/applications
# Copy this file to `.env.local` and paste your key below, then restart `npm run dev`.
#
# Without a key the globe still renders using a bundled sample dataset
# (a "sample data" chip is shown), so the demo never breaks offline.
NEXT_PUBLIC_OPENCHARGEMAP_API_KEY=
